93911439405,0.5563756963698298,0.5341950423924657,0.5410311815460097,0.5468844175255246,0.5539562794636061,0.5472360010206271,0.5276941345168455,0.5374383922248283,0.5376319004261122,0.5376420134244767,0.5350326546454721,0.5344449823175723,0.5405157887048665,0.551158999660156,0.5572381961337554,0.5298493911439405,0.5563756963698298,0.5341950423924657,0.5410311815460097,0.5468844175255246,0.5539562794636061,0.5472360010206271,0.5276941345168455,0.5374383922248283,0.5376319004261122,0.5376420134244767,0.5350326546454721,0.5344449823175723,0.5405157887048665,0.551158999660156,0.5572381961337554,0.5298493911439405,0.5563756963698298,0.5341950423924657,0.5410311815460097,0.5468844175255246,0.5539562794636061,0.5472360010206271,0.5276941345168455,0.5374383922248283,0.5376319004261122,0.5376420134244767,0.5350326546454721,0.5344449823175723,0.5405157887048665,0.551158999660156,0.5572381961337554,0.5298493911439405,0.5563756963698298,0.5341950423924657,0.5410311815460097,0.5468844175255246,0.5539562794636061,0.5472360010206271,0.5276941345168455,0.5374383922248283,0.5376319004261122,0.5376420134244767,0.5350326546454721,0.5344449823175723,0.5405157887048665,0.551158999660156,0.5572381961337554,0.5298493911439405,0.5563756963698298,0.5341950423924657,0.5410311815460097,0.5468844175255246,0.5539562794636061,0.5472360010206271,0.5276941345168455,0.5374383922248283,0.5376319004261122],"preparation_ns":21262,"query_ns":1204014,"region_backend":"state_readout","snapshot_ns":581325,"threshold":0.534912043301759,"tick":2,"total_ns":2663011,"vertices":64}}],"query_count":256}],"pid":1032,"pilot":true,"process_index":0,"protocol":{"batches_per_process":5,"build_jobs":1,"cases":[{"expected_auto":"complete_graph","family":"clique","id":"clique_n7","n":7},{"expected_auto":"complete_graph","family":"clique","id":"clique_n13","n":13},{"expected_auto":"complete_graph","family":"clique","id":"clique_n32","n":32},{"expected_auto":"complete_graph","family":"clique","id":"clique_n64","n":64},{"expected_auto":"spectral","family":"path","id":"path_n13","n":13},{"expected_auto":"spectral","family":"path","id":"path_n64","n":64},{"expected_auto":"spectral","family":"near_clique","id":"near_clique_n13","n":13},{"expected_auto":"spectral","family":"near_clique","id":"near_clique_n64","n":64}],"cold_and_amortized":"Every measurement starts a fresh Engine, performs all required ingest steps, constructs one immutable snapshot and prepares one source/region. It then issues 1,16,or256 time queries on that snapshot. The query time sequence cycles through the 16 predeclared positive times. The q=1 case uses t=0.25; t=0 is a separate functional control.","comparison":"Three variants of the same scalar task: forced full spectral state evaluation; automatic backend with full state evaluation; automatic backend with precompiled fixed-region scalar readout. All produce every requested mass and band decision. Complete fields are separately recorded for functional checks, not forced into the scalar timing contract.","component_absolute_tolerance":5e-10,"component_relative_tolerance":5e-10,"configuration":"Config::default with persistence.lambda_decay=0 and consensus.min_crystal_tick=u64::MAX. Actual public Engine::step performs canonicalization, ingestion, graph embeddings, carrier updates and metrics. The explicit read-only observation workload suppresses crystal extraction/commit/morphogenesis; it does not measure legacy crystal throughput.","deadband":1e-7,"fresh_processes":7,"graph":"Clique: one batch of n distinct sources. Path: n-1 pair batches (i,i+1). Near-clique: two batches {0,...,n-2}, {0,...,n-3,n-1}, omitting exactly edge {n-2,n-1}. No raw graph mutation. Payloads are frozen canonical JSON ASCII with entity, tick, phase=0. Stable source IDs are sensor-i. Snapshot uses the engine-defined symmetric weighted Laplacian.","mass_absolute_tolerance":5e-10,"norm_absolute_tolerance":5e-10,"order":"For every case/query-count/batch, cyclically rotate the three variant names by (process_index+case_index+query_count_index+batch_index)%3 and reverse the order on odd (process_index+batch_index). Each fresh process contains all paired variants. One untimed complete task per case/query-count/variant precedes the measured batches.","profile":{"codegen_units":1,"debug":true,"lto":false,"opt_level":3,"overflow_checks":false,"panic":"unwind","strip":"none"},"query_counts":[1,16,256],"query_times":[0.25,0.03125,0.125,0.5,1.0,2.0,4.0,8.0,0.0625,0.375,0.75,1.5,3.0,6.0,10.0,16.0],"region":"The even-index source IDs; scalar normalized region mass. Threshold equals the same source region mass at t=0; fixed deadband=1e-7. Return above, below, or abstain relative to that threshold. The deadband is a declared decision policy, not a machine-verified roundoff certificate.","schema":"gabriel.conditioned-engine.protocol.v1","source":"For each source i, raw re=((17*i+3)%29)-14 and im=((11*i+5)%23)-11. Normalize once in increasing source-index order. Align those values to immutable snapshot VertexIds; no future label or outcome exists or is read. The observer then applies its contractually stable maximum-component normalization before propagation; golden records retain both caller source and normalized unit_source.","summary":"For each case/query-count/phase/process, use the median of five within-batch paired ratios. Report across seven fresh processes the median and observed minimum/maximum. Three pairs: spectral_full/auto_full, spectral_full/auto_region, auto_full/auto_region. No confidence intervals, throughput extrapolation, forecast-accuracy claim, hardware universality or platform comparison.","timing":"Total timer includes Engine construction, all public ingest, snapshot construction and validation, source ID alignment/normalization, source/region preparation, all mass evaluations, band decisions, response-vector creation, black_box, and Engine/snapshot/prepared-state destruction. The returned scalar response vectors survive the timer for validation; their later JSON encoding and destruction are excluded. Input byte generation, the frozen Config construction, process startup, golden validation, JSON encoding and disk IO are excluded. Separate nested nonoverlapping ingest, snapshot, preparation and query spans are retained; total also includes timer/counter bookkeeping and all destruction. Ingestion includes Engine construction.","toolchain":"1.95.0","validation":"One golden command records every actual graph Laplacian, immutable VertexId mapping, stimulus, fixed region, 17 times (t=0 plus all query times), full amplitudes, normalized intensities, norm ratios, all three scalar masses and decisions. Validate complete Auto/Spectral vectors, scalar agreement, norm preservation and identical decisions. Additional explicit uniform, one-hot and real-zero-mean sources expose clique degeneracies. Identity of the normalized prepared state at zero time and source-label permutation equivariance are checked independently.","variants":["spectral_full","auto_full","auto_region"]},"schema":"gabriel.conditioned-engine.measurements.v1"}
