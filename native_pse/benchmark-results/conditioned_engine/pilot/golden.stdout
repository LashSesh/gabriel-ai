0.0,"split_threshold":0.8,"top_k_attractor":5},"archive":{"max_chain_length":0},"calibration":{"enabled":false,"target_pass_rate":0.05,"warmup_ticks":100,"window":200},"carrier":{"adaptive":false,"eta_r":1.0,"lambda":0.1,"lambda_m":0.34,"lambda_q":0.33,"lambda_r":0.33,"mu_r":0.3,"num_carriers":4,"thresholds":{"d":0.5,"f_friction":0.7,"g":0.5,"j":0.5,"k":0.5,"l_migration":0.6,"n":0.5,"p":0.5,"q":0.5,"r":0.5,"s_shock":0.7},"use_metatron_ladder":false},"consensus":{"archive_dominance":0.7,"background_z_threshold":0.0,"consensus_threshold":0.6,"crystal_cooldown_ticks":0,"memory_similarity_threshold":0.85,"min_crystal_tick":18446744073709551615,"mirror_consistency_eta":0.8,"por_epsilon":0.05,"por_kappa_bar":0.7,"por_t_min":3,"por_t_stable":2,"startup_crystal_count":0},"extraction":{"alpha_min":0.5,"convergence_tau":0.01,"epsilon_merge":0.1,"kappa_max":0.9,"window_hours":24.0},"falsification":{"alpha":0.05,"comparability_tolerance":0.1,"enabled":false,"gate_on_fail":true,"k":50,"method":"Shuffle"},"normalization":{"gamma_d":0.33,"gamma_q":0.33,"gamma_r":0.34,"lambda_c":1.0,"lambda_e":0.0,"lambda_p":1.0,"lambda_r":1.0,"lambda_seam":0.1,"mu_d":0.2,"mu_f":1.0,"mu_j":1.0,"mu_q":1.0,"mu_s":1.0},"observation":{"schema_version":""},"persistence":{"hot_retention_days":7,"lambda_decay":0.0,"max_vertices":10000,"warm_retention_days":90},"temporal":{"c_temp":5.0,"dt2":0.01,"gamma":0.01,"t_default":1.0},"thresholds":{"d":0.5,"f_friction":0.7,"g":0.5,"j":0.5,"k":0.5,"l_migration":0.6,"n":0.5,"p":0.5,"q":0.5,"r":0.5,"s_shock":0.7}},"protocol":{"batches_per_process":5,"build_jobs":1,"cases":[{"expected_auto":"complete_graph","family":"clique","id":"clique_n7","n":7},{"expected_auto":"complete_graph","family":"clique","id":"clique_n13","n":13},{"expected_auto":"complete_graph","family":"clique","id":"clique_n32","n":32},{"expected_auto":"complete_graph","family":"clique","id":"clique_n64","n":64},{"expected_auto":"spectral","family":"path","id":"path_n13","n":13},{"expected_auto":"spectral","family":"path","id":"path_n64","n":64},{"expected_auto":"spectral","family":"near_clique","id":"near_clique_n13","n":13},{"expected_auto":"spectral","family":"near_clique","id":"near_clique_n64","n":64}],"cold_and_amortized":"Every measurement starts a fresh Engine, performs all required ingest steps, constructs one immutable snapshot and prepares one source/region. It then issues 1,16,or256 time queries on that snapshot. The query time sequence cycles through the 16 predeclared positive times. The q=1 case uses t=0.25; t=0 is a separate functional control.","comparison":"Three variants of the same scalar task: forced full spectral state evaluation; automatic backend with full state evaluation; automatic backend with precompiled fixed-region scalar readout. All produce every requested mass and band decision. Complete fields are separately recorded for functional checks, not forced into the scalar timing contract.","component_absolute_tolerance":5e-10,"component_relative_tolerance":5e-10,"configuration":"Config::default with persistence.lambda_decay=0 and consensus.min_crystal_tick=u64::MAX. Actual public Engine::step performs canonicalization, ingestion, graph embeddings, carrier updates and metrics. The explicit read-only observation workload suppresses crystal extraction/commit/morphogenesis; it does not measure legacy crystal throughput.","deadband":1e-7,"fresh_processes":7,"graph":"Clique: one batch of n distinct sources. Path: n-1 pair batches (i,i+1). Near-clique: two batches {0,...,n-2}, {0,...,n-3,n-1}, omitting exactly edge {n-2,n-1}. No raw graph mutation. Payloads are frozen canonical JSON ASCII with entity, tick, phase=0. Stable source IDs are sensor-i. Snapshot uses the engine-defined symmetric weighted Laplacian.","mass_absolute_tolerance":5e-10,"norm_absolute_tolerance":5e-10,"order":"For every case/query-count/batch, cyclically rotate the three variant names by (process_index+case_index+query_count_index+batch_index)%3 and reverse the order on odd (process_index+batch_index). Each fresh process contains all paired variants. One untimed complete task per case/query-count/variant precedes the measured batches.","profile":{"codegen_units":1,"debug":true,"lto":false,"opt_level":3,"overflow_checks":false,"panic":"unwind","strip":"none"},"query_counts":[1,16,256],"query_times":[0.25,0.03125,0.125,0.5,1.0,2.0,4.0,8.0,0.0625,0.375,0.75,1.5,3.0,6.0,10.0,16.0],"region":"The even-index source IDs; scalar normalized region mass. Threshold equals the same source region mass at t=0; fixed deadband=1e-7. Return above, below, or abstain relative to that threshold. The deadband is a declared decision policy, not a machine-verified roundoff certificate.","schema":"gabriel.conditioned-engine.protocol.v1","source":"For each source i, raw re=((17*i+3)%29)-14 and im=((11*i+5)%23)-11. Normalize once in increasing source-index order. Align those values to immutable snapshot VertexIds; no future label or outcome exists or is read. The observer then applies its contractually stable maximum-component normalization before propagation; golden records retain both caller source and normalized unit_source.","summary":"For each case/query-count/phase/process, use the median of five within-batch paired ratios. Report across seven fresh processes the median and observed minimum/maximum. Three pairs: spectral_full/auto_full, spectral_full/auto_region, auto_full/auto_region. No confidence intervals, throughput extrapolation, forecast-accuracy claim, hardware universality or platform comparison.","timing":"Total timer includes Engine construction, all public ingest, snapshot construction and validation, source ID alignment/normalization, source/region preparation, all mass evaluations, band decisions, response-vector creation, black_box, and Engine/snapshot/prepared-state destruction. The returned scalar response vectors survive the timer for validation; their later JSON encoding and destruction are excluded. Input byte generation, the frozen Config construction, process startup, golden validation, JSON encoding and disk IO are excluded. Separate nested nonoverlapping ingest, snapshot, preparation and query spans are retained; total also includes timer/counter bookkeeping and all destruction. Ingestion includes Engine construction.","toolchain":"1.95.0","validation":"One golden command records every actual graph Laplacian, immutable VertexId mapping, stimulus, fixed region, 17 times (t=0 plus all query times), full amplitudes, normalized intensities, norm ratios, all three scalar masses and decisions. Validate complete Auto/Spectral vectors, scalar agreement, norm preservation and identical decisions. Additional explicit uniform, one-hot and real-zero-mean sources expose clique degeneracies. Identity of the normalized prepared state at zero time and source-label permutation equivariance are checked independently.","variants":["spectral_full","auto_full","auto_region"]},"schema":"gabriel.conditioned-engine.golden.v1"}
