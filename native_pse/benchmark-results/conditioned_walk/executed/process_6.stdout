8,-0.11635161734460311],[0.010944514275922662,-0.00890989210367031],[0.02337745351076611,-0.11526346094258699],[0.04363793955556459,0.10825829066725715]],"spectral_norm_squared":0.999999999999999,"time":100.0}]},"validation_ns":302186,"warmup_ns":1408401}],"pid":895,"process_index":6,"protocol":{"batches_per_process":5,"build_jobs":1,"cases":[{"expected_auto":"complete_graph","family":"clique","id":"clique_n7_w025","n":7,"queries_per_batch":16384,"weight":0.25},{"expected_auto":"complete_graph","family":"clique","id":"clique_n13_w025","n":13,"queries_per_batch":8192,"weight":0.25},{"expected_auto":"complete_graph","family":"clique","id":"clique_n32_w025","n":32,"queries_per_batch":4096,"weight":0.25},{"expected_auto":"complete_graph","family":"clique","id":"clique_n64_w025","n":64,"queries_per_batch":2048,"weight":0.25},{"expected_auto":"complete_graph","family":"clique","id":"clique_n128_w025","n":128,"queries_per_batch":1024,"weight":0.25},{"expected_auto":"complete_graph","family":"clique","id":"clique_n13_w1","n":13,"queries_per_batch":8192,"weight":1.0},{"expected_auto":"spectral","family":"clique","id":"clique_n13_w17_guard","n":13,"queries_per_batch":8192,"weight":1.7},{"expected_auto":"spectral","family":"near_clique","id":"near_clique_n13_w025","n":13,"queries_per_batch":8192,"weight":0.25},{"expected_auto":"spectral","family":"near_clique","id":"near_clique_n64_w025","n":64,"queries_per_batch":2048,"weight":0.25},{"expected_auto":"spectral","family":"path","id":"path_n13_w025","n":13,"queries_per_batch":8192,"weight":0.25},{"expected_auto":"spectral","family":"path","id":"path_n64_w025","n":64,"queries_per_batch":2048,"weight":0.25}],"checksum_absolute_tolerance":1e-8,"checksum_relative_tolerance":1e-8,"comparison":"Auto and forced Spectral return the same full complex state vector for exp(-itL) from one prepared complex initial state.","component_absolute_tolerance":5e-10,"component_relative_tolerance":5e-10,"fresh_processes":7,"graph":"Both directed entries of each positive edge; no diagonal or duplicate entries. Degrees accumulate neighbours in ascending index order. Clique weights are constant. Near-clique uses twice the declared weight on edge {0,1}. Path has nearest-neighbour edges only.","input_state":"re_i=((17*i+3)%29)-14; im_i=((11*i+5)%23)-11; normalize by sqrt(sum_i(re_i^2+im_i^2)); no RNG.","norm_absolute_tolerance":5e-10,"order":"Both variants execute in each fresh process; order reverses with parity of process_index + case_index + batch_index. Setup, preparation, and query phases share this order convention.","preparation":"Five prepare_state calls are timed per variant; each computes the spectral overlaps or complete-graph mean. Fresh final prepared states are then reused for all timed queries.","profile":{"codegen_units":1,"debug":true,"lto":false,"opt_level":3,"overflow_checks":false,"panic":"unwind","strip":"none"},"queries":"Fixed repetitions cycle through all 16 predeclared times. Every distinct vector output is validated componentwise before any query timings. Timed loops black_box the complete returned vector and accumulate one varying component into a checksum. Allocation, return-value validation, black_box, checksum addition and vector destruction are included; setup, state preparation, correctness validation, warmup, JSON serialization and process startup are excluded.","schema":"gabriel.conditioned-walk.protocol.v1","setup":"Graph construction and initial-state generation are separately recorded once. Plan setup includes validation, dispatch, dense construction and any full eigendecomposition; it excludes graph generation. Five warmed plan constructors are timed for each variant. The last plans are used for subsequent work.","summary":"For each case and fresh process, take median(Spectral_ns / Auto_ns) across paired query batches. Across processes report the median and observed minimum/maximum. Also retain setup and preparation pairs. No confidence interval, statistical significance, cross-machine prediction or whole-engine improvement is claimed.","times":[0.0,-100.0,-10.0,-1.0,-0.125,0.001,0.03125,0.125,0.25,0.5,1.0,2.0,4.0,8.0,10.0,100.0],"toolchain":"1.95.0","warmup_queries_per_backend":128},"schema":"gabriel.conditioned-walk.measurements.v1","scope":"Prepared state-vector queries only; not the existing all-pairs threshold scan or whole Gabriel engine."}
