{
  "$id": "https://gabriel.invalid/spec/1/software-patch-proposal.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Model output (UTF-8 allowed). Unknown kinds reject during normalization; they never default to create.",
  "properties": {
    "claims_done": {
      "type": "boolean"
    },
    "operations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "anyOf": [
              {
                "maxLength": 1048576,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "expected_sha256": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "maxLength": 32,
            "type": "string"
          },
          "path": {
            "maxLength": 512,
            "type": "string"
          }
        },
        "required": [
          "kind",
          "path",
          "expected_sha256",
          "content"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "minItems": 0,
      "type": "array"
    },
    "rationale": {
      "maxLength": 8000,
      "type": "string"
    }
  },
  "required": [
    "operations",
    "rationale"
  ],
  "title": "software-patch-proposal",
  "type": "object"
}
