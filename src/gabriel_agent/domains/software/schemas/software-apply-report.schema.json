{
  "$id": "https://gabriel.invalid/spec/1/software-apply-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Software domain pack record; representation only.",
  "properties": {
    "applied": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "create",
              "modify",
              "delete"
            ],
            "type": "string"
          },
          "path": {
            "pattern": "^[ -~]{1,512}$",
            "type": "string"
          },
          "result_sha256": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "kind",
          "path",
          "result_sha256"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "minItems": 0,
      "type": "array"
    },
    "complete": {
      "type": "boolean"
    },
    "failed_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/safe_uint"
        },
        {
          "type": "null"
        }
      ]
    },
    "patch_ref": {
      "$ref": "common.schema.json#/$defs/artifact_ref"
    },
    "post_tree_digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "pre_tree_digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 512,
          "pattern": "^[ -~]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema": {
      "const": "gabriel.software-apply-report/1",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "patch_ref",
    "applied",
    "failed_at",
    "reason",
    "pre_tree_digest",
    "post_tree_digest",
    "complete"
  ],
  "title": "software-apply-report",
  "type": "object"
}
