{
  "$id": "https://gabriel.invalid/spec/1/numerical-snapshot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Observed numerical worktree: dataset identities with their declared units, time basis, kind and detected problems.",
  "properties": {
    "base_commit": {
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "coverage": {
      "additionalProperties": false,
      "properties": {
        "does_not_observe": {
          "items": {
            "maxLength": 512,
            "pattern": "^[ -~]*$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "observes": {
          "items": {
            "maxLength": 512,
            "pattern": "^[ -~]*$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "does_not_observe",
        "observes"
      ],
      "type": "object"
    },
    "datasets": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "$ref": "common.schema.json#/$defs/safe_uint"
          },
          "format": {
            "enum": [
              "json",
              "unsupported"
            ],
            "type": "string"
          },
          "kind": {
            "enum": [
              "series",
              "graph",
              "table",
              "observation_batches",
              "graph_query",
              "graph_window_query",
              "unknown"
            ],
            "type": "string"
          },
          "path": {
            "maxLength": 512,
            "pattern": "^[ -~]*$",
            "type": "string"
          },
          "problems": {
            "items": {
              "maxLength": 256,
              "pattern": "^[ -~]*$",
              "type": "string"
            },
            "maxItems": 16,
            "minItems": 0,
            "type": "array"
          },
          "rows": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/safe_uint"
              },
              {
                "type": "null"
              }
            ]
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          },
          "time_basis": {
            "anyOf": [
              {
                "enum": [
                  "unix_ms",
                  "index",
                  "unknown"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "units": {
            "anyOf": [
              {
                "maxLength": 32,
                "pattern": "^[ -~]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "bytes",
          "format",
          "kind",
          "path",
          "problems",
          "rows",
          "sha256",
          "time_basis",
          "units"
        ],
        "type": "object"
      },
      "maxItems": 64,
      "minItems": 0,
      "type": "array"
    },
    "extraction_profile": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "head_commit": {
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "manifest_ref": {
      "$ref": "common.schema.json#/$defs/artifact_ref"
    },
    "observed_frontier": {
      "$ref": "common.schema.json#/$defs/safe_uint"
    },
    "schema": {
      "const": "gabriel.numerical-snapshot/1",
      "type": "string"
    },
    "tree_digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "worktree_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    }
  },
  "required": [
    "base_commit",
    "coverage",
    "datasets",
    "extraction_profile",
    "head_commit",
    "manifest_ref",
    "observed_frontier",
    "schema",
    "tree_digest",
    "worktree_id"
  ],
  "title": "numerical-snapshot",
  "type": "object"
}
