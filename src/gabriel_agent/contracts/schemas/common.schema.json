          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "model_requests": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "model_tokens_total": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "scratch_bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "tool_attempts": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
