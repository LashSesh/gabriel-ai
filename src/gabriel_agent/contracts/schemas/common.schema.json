          "minimum": 0,
          "type": "integer"
        },
        "cpu_ms": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "currency_micro_units": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
