        "bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9!#$&^_.+/-]+(?:;[ -~]+)?$",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "bytes",
        "media_type"
      ],
      "type": "object"
    },
    "budget": {
      "additionalProperties": false,
      "properties": {
