{
  "$id": "https://gabriel.invalid/spec/1/retrieval-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Ordered manifest of artifact/span references selected at an issue frontier after authorization and temporal filtering; scores rank relevance and are not factual confidence.",
  "properties": {
    "access_policy_revision": {
      "$ref": "common.schema.json#/$defs/safe_uint"
    },
    "allowed_source_kinds": {
      "items": {
        "maxLength": 64,
        "pattern": "^[ -~]*$",
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 0,
      "type": "array"
    },
    "association": {
      "additionalProperties": false,
      "description": "ADR-20: the native engine's walk over the co-citation graph of supported claims, as computed for this retrieval",
      "properties": {
        "batches_sha256": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "entities": {
          "items": {
            "maxLength": 512,
            "pattern": "^[ -~]*$",
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "executable_sha256": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "links": {
          "type": "object",
          "maxProperties": 256,
          "description": "ADR-21: for every carried key (mass from the walk, not a seed), the seeds it was cited together with and the claims and tasks of the verified runs that cited them together",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "direct": {
                "type": "boolean"
              },
              "seeds": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^[ -~]*$"
                }
              },
              "claims": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "$ref": "common.schema.json#/$defs/identifier"
                }
              },
              "task_ids": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "maxLength": 256,
                  "pattern": "^[ -~]*$"
                }
              }
            },
            "required": [
              "direct",
              "seeds",
              "claims",
              "task_ids"
            ]
          }
        },
        "masses_milli": {
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/safe_uint"
          },
          "maxProperties": 256,
          "type": "object"
        },
        "profile": {
          "additionalProperties": false,
          "properties": {
            "backend": {
              "enum": [
                "spectral_full",
                "auto_full",
                "auto_region"
              ],
              "type": "string"
            },
            "combination": {
              "enum": [
                "max"
              ],
              "type": "string"
            },
            "max_entities": {
              "$ref": "common.schema.json#/$defs/safe_uint"
            },
            "max_seeds": {
              "$ref": "common.schema.json#/$defs/safe_uint"
            },
            "profile_id": {
              "$ref": "common.schema.json#/$defs/identifier"
            },
            "schema": {
              "const": "gabriel.association-profile/1",
              "type": "string"
            },
            "seed_min_score_milli": {
              "$ref": "common.schema.json#/$defs/safe_uint"
            },
            "time_bits": {
              "pattern": "^[0-9a-f]{16}$",
              "type": "string"
            }
          },
          "required": [
            "schema",
            "profile_id",
            "time_bits",
            "backend",
            "max_seeds",
            "max_entities",
            "seed_min_score_milli",
            "combination"
          ],
          "type": "object"
        },
        "schema": {
          "const": "gabriel.association-record/1",
          "type": "string"
        },
        "seeds": {
          "items": {
            "maxLength": 512,
            "pattern": "^[ -~]*$",
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "snapshot_identity": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "computed",
            "no_history",
            "no_seeds",
            "no_seeds_in_history",
            "capacity_exceeded",
            "unavailable"
          ],
          "type": "string"
        }
      },
      "required": [
        "schema",
        "profile",
        "status",
        "executable_sha256",
        "batches_sha256",
        "entities",
        "seeds",
        "snapshot_identity",
        "masses_milli"
      ],
      "type": "object"
    },
    "cache_key": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "cached": {
      "type": "boolean"
    },
    "excluded": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "observation_id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "reason": {
            "enum": [
              "contested",
              "unresolved_revision",
              "superseded",
              "revoked",
              "out_of_scope",
              "kind_not_allowed",
              "budget"
            ],
            "type": "string"
          }
        },
        "required": [
          "observation_id",
          "reason"
        ],
        "type": "object"
      },
      "maxItems": 1024,
      "minItems": 0,
      "type": "array"
    },
    "frontier": {
      "additionalProperties": false,
      "properties": {
        "memory_sequence": {
          "$ref": "common.schema.json#/$defs/safe_uint"
        },
        "owner_sequence": {
          "$ref": "common.schema.json#/$defs/safe_uint"
        }
      },
      "required": [
        "memory_sequence",
        "owner_sequence"
      ],
      "type": "object"
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifact_ref": {
            "$ref": "common.schema.json#/$defs/artifact_ref"
          },
          "lexical_milli": {
            "$ref": "common.schema.json#/$defs/safe_uint",
            "description": "ADR-21: the lexical score before the association re-ranking, retained so a carried source can be told apart"
          },
          "observation_id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "score_milli": {
            "$ref": "common.schema.json#/$defs/safe_uint"
          },
          "source_id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "source_kind": {
            "maxLength": 64,
            "pattern": "^[ -~]*$",
            "type": "string"
          },
          "source_revision": {
            "$ref": "common.schema.json#/$defs/safe_uint"
          },
          "span_end": {
            "$ref": "common.schema.json#/$defs/safe_uint"
          },
          "span_start": {
            "$ref": "common.schema.json#/$defs/safe_uint"
          },
          "structural_milli": {
            "$ref": "common.schema.json#/$defs/safe_uint"
          }
        },
        "required": [
          "artifact_ref",
          "observation_id",
          "score_milli",
          "source_id",
          "source_kind",
          "source_revision",
          "span_end",
          "span_start"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "minItems": 0,
      "type": "array"
    },
    "manifest_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "max_bytes": {
      "$ref": "common.schema.json#/$defs/safe_uint"
    },
    "max_items": {
      "$ref": "common.schema.json#/$defs/safe_uint"
    },
    "principal_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "query_ref": {
      "$ref": "common.schema.json#/$defs/artifact_ref"
    },
    "schema": {
      "const": "gabriel.retrieval-manifest/1",
      "type": "string"
    },
    "task_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "version_policy": {
      "enum": [
        "highest_revision",
        "earliest_ingested",
        "all_revisions"
      ],
      "type": "string"
    },
    "workspace_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    }
  },
  "required": [
    "access_policy_revision",
    "allowed_source_kinds",
    "cache_key",
    "cached",
    "excluded",
    "frontier",
    "items",
    "manifest_id",
    "max_bytes",
    "max_items",
    "principal_id",
    "query_ref",
    "schema",
    "task_id",
    "version_policy",
    "workspace_id"
  ],
  "title": "retrieval-manifest",
  "type": "object"
}
