{
  "$id": "https://gabriel.invalid/spec/1/task-amendment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Closed gabriel_agent contract; representation only, cross-record rules are enforced by the owner.",
  "properties": {
    "amendment_kind": {
      "enum": [
        "clarify",
        "weaken_acceptance"
      ],
      "type": "string"
    },
    "compilation_report_ref": {
      "$ref": "common.schema.json#/$defs/artifact_ref"
    },
    "goal_spec_ref": {
      "$ref": "common.schema.json#/$defs/artifact_ref"
    },
    "principal_confirmation": {
      "type": "boolean"
    },
    "reason_ref": {
      "$ref": "common.schema.json#/$defs/artifact_ref"
    },
    "schema": {
      "const": "gabriel.task-amendment/1",
      "type": "string"
    },
    "task": {
      "$ref": "task.schema.json"
    }
  },
  "required": [
    "schema",
    "task",
    "reason_ref",
    "amendment_kind",
    "goal_spec_ref",
    "compilation_report_ref",
    "principal_confirmation"
  ],
  "title": "task-amendment",
  "type": "object"
}
