  "source_review": {
    "Store": "DELETE/EXTRA; explicit BEGIN IMMEDIATE; commit before receipt; close closes connection; no writer threads",
    "audit": "BEGIN plus read-only semantic replay; optional anchors detect valid prefixes; no restorative database write",
    "native_adapter": "subprocess.run waits; JSON stdin carries graph data and no database path; default close_fds; no delayed writer found",
    "prior_checker": "sqlite3 connection context manager ends transaction rather than explicitly closing connection; new probe explicitly closes all readers; no read-connection path restores a historical prefix"
  },
  "environment_findings": {
    "same_root_overlay_mount": true,
    "fsync_volatile": true,
    "workspace_writable_rsync_module": true,
    "observed_replacement": false,
    "observed_rsync_writer_pid": false
  },
  "limitations": [
    "No old regression reproduced; the 24-case probe is a narrow live-file check, not a statistical durability guarantee.",
    "The original 32 unexpected files and two older workspace replay failures remain unresolved historical observations.",
    "Writable workspace synchronization is a concrete candidate write route, not proven cause.",
    "No power loss or kernel crash was tested. fsync=volatile prevents claiming backing-store persistence from successful fsync returns."
  ],
  "primary_sources": [
    {
      "url": "https://sqlite.org/pragma.html#pragma_synchronous",
      "relevance": "EXTRA adds DELETE-journal directory synchronization."
