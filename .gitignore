.venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
/workspace-*/
# evaluation runs: the materialized task repositories and worktrees are git repositories of their own
# and are reproducible from the frozen corpus; the final diffs are retained under final_diffs/ instead
evidence/wp11/*/runs/*/repo/
evidence/wp11/*/runs/*/worktrees/
evidence/wp11/*/runs/*/*-ws/worktrees/
evidence/wp11/*/runs/*/store/tmp/
# evaluation workspaces: per-workspace principal secrets are never evidence
evidence/**/credentials/
# AT23 evidence workspace: materialized repositories, worktrees, scratch and principal secrets are not evidence
evidence/wp10/**/credentials/
evidence/wp10/**/worktrees/
evidence/wp10/*/*/repo/
evidence/wp10/*/at16-work/
# G3 route evidence: materialized repositories, worktrees, scratch and principal secrets are not evidence
evidence/wp13/*/runs/*/repo/
evidence/wp13/*/runs/*/worktrees/
evidence/wp13/*/runs/*/*-ws/worktrees/
evidence/wp13/*/runs/*/store/tmp/
evidence/wp13/**/credentials/
evidence/wp13/**/promotion-workspace/worktrees/
# protocol 5 evidence: materialized repositories, worktrees, scratch and principal secrets are not evidence
evidence/wp14/*/runs/*/repo/
evidence/wp14/*/runs/*/worktrees/
evidence/wp14/*/runs/*/*-ws/worktrees/
evidence/wp14/*/runs/*/store/tmp/
evidence/wp14/**/credentials/

# native PSE build tree: executables are rebuilt from the locked sources (evidence/pse/build_identity.json records the digests)
native_pse/target/
