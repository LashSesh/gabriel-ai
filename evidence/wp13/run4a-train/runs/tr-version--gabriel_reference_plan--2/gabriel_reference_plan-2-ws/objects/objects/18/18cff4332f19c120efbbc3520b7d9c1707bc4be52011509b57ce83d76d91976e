{"operations":[{"content":"\"\"\"versions: dotted version comparison.\"\"\"\n\ndef compare(a, b):\n    \"\"\"Return -1, 0 or 1 comparing dotted numeric versions numerically per component.\"\"\"\n    a_components = [int(x) for x in a.split('.')]\n    b_components = [int(x) for x in b.split('.')]\n    max_length = max(len(a_components), len(b_components))\n    a_components.extend([0] * (max_length - len(a_components)))\n    b_components.extend([0] * (max_length - len(b_components)))\n    for a_part, b_part in zip(a_components, b_components):\n        if a_part > b_part:\n            return 1\n        elif a_part < b_part:\n            return -1\n    return 0","expected_sha256":"dd2aa5c4cfa6a9b6f791e4be638bad93c4dc07d97e7f2d801a2b72198f335e6d","kind":"modify","path":"src/versions.py"}],"rationale":"The original compare function was a placeholder that did not perform numeric comparison per component. The new implementation splits the version strings into integer components, pads shorter versions with zeros, and compares each component numerically, ensuring correct ordering such as '1.10' > '1.9', '1.0.1' > '1.0', and '1.0' == '1.0.0'."}