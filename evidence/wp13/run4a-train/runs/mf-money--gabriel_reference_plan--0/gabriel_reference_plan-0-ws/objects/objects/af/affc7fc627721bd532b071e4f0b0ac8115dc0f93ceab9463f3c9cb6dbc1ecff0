{"operations":[{"content":"\"\"\"money: cent rounding for ledgers.\"\"\"\n\nimport decimal\n\ndef round_cents(amount):\n    \"\"\"Round a decimal amount to cents, halves away from zero.\"\"\"\n    d = decimal.Decimal(str(amount))\n    # Set rounding mode to ROUND_HALF_UP for halves away from zero\n    return float(d.quantize(decimal.Decimal('0.01'), rounding=decimal.ROUND_HALF_UP))","expected_sha256":"fa816984cb1f791630c850f452d214933dceee46a979c2276da8800a2c0570db","kind":"modify","path":"src/money.py"}],"rationale":"The original implementation used Python's built-in round(), which implements banker's rounding (half to even). To achieve halves away from zero, we switch to the decimal module with ROUND_HALF_UP, ensuring correct rounding behavior for all cases, including halves."}