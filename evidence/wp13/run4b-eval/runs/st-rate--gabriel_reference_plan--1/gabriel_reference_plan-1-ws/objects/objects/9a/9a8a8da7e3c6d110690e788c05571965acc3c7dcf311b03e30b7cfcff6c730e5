{"operations":[{"content":"\"\"\"ratelimit: fixed-window request limiter with an injectable clock.\"\"\"\n\n\nclass Limiter:\n    def __init__(self, limit, window_s, clock):\n        self.limit, self.window_s, self.clock = limit, window_s, clock\n        self.count = 0\n        self.window_start = clock()\n\n    def allow(self):\n        \"\"\"True while fewer than `limit` requests were allowed in the current window.\"\"\"\n        now = self.clock()\n        if now - self.window_start >= self.window_s:\n            self.window_start = now\n            self.count = 0\n        if self.count < self.limit:\n            self.count += 1\n            return True\n        return False\n","expected_sha256":"37b7f0537a5c180ebd9f4e7b3e38c65dd158665aeee0f8b42b4d4decaee94784","kind":"modify","path":"src/ratelimit.py"}],"rationale":"Reset the request count to zero when a new fixed window starts, ensuring the count accumulates only within the current window as required."}