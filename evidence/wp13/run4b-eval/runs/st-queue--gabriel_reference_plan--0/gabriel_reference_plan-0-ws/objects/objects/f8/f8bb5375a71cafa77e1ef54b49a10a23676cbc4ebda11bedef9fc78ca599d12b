"""pq: priority queue, lowest priority value first, FIFO among equal priorities."""
import heapq


class PriorityQueue:
    def __init__(self):
        self._heap = []

    def push(self, priority, item):
        heapq.heappush(self._heap, (priority, item))

    def pop(self):
        return heapq.heappop(self._heap)[1]



