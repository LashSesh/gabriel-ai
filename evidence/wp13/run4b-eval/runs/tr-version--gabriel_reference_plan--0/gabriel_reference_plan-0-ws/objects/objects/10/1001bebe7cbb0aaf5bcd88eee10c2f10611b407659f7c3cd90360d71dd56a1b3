{"operations":[{"content":"\"\"\"versions: dotted version comparison.\"\"\"\n\n\ndef compare(a, b):\n    \"\"\"Return -1, 0 or 1 comparing dotted numeric versions numerically per component.\"\"\"\n    a_parts = [int(x) for x in a.split('.')]\n    b_parts = [int(x) for x in b.split('.')]\n\n    # Extend the shorter list with zeros (e.g. '1.0' == '1.0.0')\n    max_len = max(len(a_parts), len(b_parts))\n    a_parts.extend([0] * (max_len - len(a_parts)))\n    b_parts.extend([0] * (max_len - len(b_parts)))\n\n    for a_part, b_part in zip(a_parts, b_parts):\n        if a_part < b_part:\n            return -1\n        elif a_part > b_part:\n            return 1\n    return 0\n","expected_sha256":"dd2aa5c4cfa6a9b6f791e4be638bad93c4dc07d97e7f2d801a2b72198f335e6d","kind":"modify","path":"src/versions.py"}],"rationale":"Fixed compare to split versions by '.', convert components to int, pad shorter version with zeros, and compare numerically per component as required."}