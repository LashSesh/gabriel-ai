def is_valid(number: str) -> bool:
    """Check if the provided number string is valid per the Luhn algorithm."""
    # Remove spaces
    number = number.replace(' ', '')
    if not number.isdigit():
        return False

    total = 0
    # Process digits from right to left
    digits = list(map(int, number))
    # The check digit is the last digit (rightmost), which is never doubled
    # Double every second digit from the right, starting from the digit before the check digit
    for i in range(len(digits) - 1, -1, -1):
        digit = digits[i]
        # Determine if this digit should be doubled
        # Positions counted from right: index from right = len(digits) - 1 - i
        # Double if index from right is odd (1,3,5,...), i.e. every second digit from right excluding check digit
        if (len(digits) - 1 - i) % 2 == 1:
            digit *= 2
            if digit > 9:
                digit -= 9
        total += digit

    return total % 10 == 0
