{"operations":[{"content":"def is_valid_email(email: str) -> bool:\n    \"\"\"Check if the given email is valid.\n\n    A valid email has exactly one '@' symbol, and the domain part must contain a dot with at least one character before and after it.\n\n    Examples:\n    - 'a@b' is invalid\n    - 'a@b.co' is valid\n    \"\"\"\n    if '@' not in email:\n        return False\n    local, domain = email.rsplit('@', 1)\n    if not local or not domain:\n        return False\n    # domain must contain a dot with at least one character before and after\n    if '.' not in domain:\n        return False\n    dot_index = domain.find('.')\n    if dot_index == 0 or dot_index == len(domain) - 1:\n        return False\n    return True\n","expected_sha256":"96a692750dc93725bdc45320b6fae8958c5c8b03105242f4cac85ac4e3f3b4db","kind":"modify","path":"src/emailcheck.py"}],"rationale":"Updated is_valid_email to enforce that the domain part contains a dot with at least one character before and after it, fulfilling the defect requirement while preserving the public API and existing tests."}