{"operations":[{"content":"def is_valid_email(email: str) -> bool:\n    \"\"\"Check if the given email is valid.\n\n    A valid email has exactly one '@' symbol, and the domain part must contain a dot with at least one character before and after it.\n\n    Examples:\n    - 'a@b' is invalid\n    - 'a@b.co' is valid\n    \"\"\"\n    if email.count('@') != 1:\n        return False\n    local, domain = email.rsplit('@', 1)\n    if not local or not domain:\n        return False\n    # domain must contain a dot with at least one character before and after\n    if '.' not in domain:\n        return False\n    dot_index = domain.find('.')\n    if dot_index == 0 or dot_index == len(domain) - 1:\n        return False\n    return True\n","expected_sha256":"741cb9ce06fe4d3cd9381e1d19082eccf68e1edac11656c95c7f6a5b28923186","kind":"modify","path":"src/emailcheck.py"}],"rationale":"Added a check to ensure exactly one '@' symbol in the email to reject invalid cases like 'two@@example.com', while preserving the existing domain dot validation and public API."}