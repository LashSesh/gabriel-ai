def is_valid(number: str) -> bool:
    """Check if the provided number string is valid according to the Luhn algorithm."""
    # Remove spaces
    number = number.replace(' ', '')
    if not number.isdigit():
        return False

    total = 0
    # Process digits from right to left
    # The rightmost digit is the check digit and is not doubled
    # Double every second digit from the right (indexing from 0)
    for i, digit_char in enumerate(reversed(number)):
        digit = int(digit_char)
        if i % 2 == 1:  # every second digit from the right (excluding check digit)
            digit *= 2
            if digit > 9:
                digit -= 9
        total += digit

    return total % 10 == 0
