{"operations":[{"content":"def split_fields(line):\n    \"\"\"Split a CSV line into fields, handling quoted fields with commas and escaped quotes.\n\n    A doubled double-quote inside a quoted field is unescaped to a single double-quote.\n    \"\"\"\n    fields = []\n    field = []\n    in_quotes = False\n    i = 0\n    length = len(line)\n\n    while i < length:\n        c = line[i]\n\n        if in_quotes:\n            if c == '\"':\n                # Check if next char is also a double quote (escaped quote)\n                if i + 1 < length and line[i + 1] == '\"':\n                    field.append('\"')\n                    i += 1  # Skip the escaped quote\n                else:\n                    in_quotes = False\n            else:\n                field.append(c)\n        else:\n            if c == ',':\n                fields.append(''.join(field))\n                field = []\n            elif c == '\"':\n                in_quotes = True\n            else:\n                field.append(c)\n        i += 1\n\n    fields.append(''.join(field))\n    return fields\n","expected_sha256":"1efa2ab596513250c35fb383e54d6413fb5f9b3e1dad574c3f0d8cda0daeb049","kind":"modify","path":"src/csvfields.py"}],"rationale":"Modified split_fields to correctly handle quoted fields containing commas and to unescape doubled double-quotes inside quoted fields, preserving the public API and existing tests."}