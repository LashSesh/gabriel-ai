{"operations":[{"content":"def is_valid_isbn10(isbn):\n    \"\"\"Return True if the given string is a valid ISBN-10.\n\n    The ISBN-10 consists of 9 digits plus a check digit which may be 0-9 or X.\n    The check digit is computed as sum((10 - i) * digit) mod 11 == 0.\n\n    The input may contain hyphens which are ignored.\n    \"\"\"\n    # Remove hyphens\n    isbn = isbn.replace('-', '')\n\n    # ISBN-10 must be 10 characters\n    if len(isbn) != 10:\n        return False\n\n    # Check first 9 characters are digits\n    if not isbn[:9].isdigit():\n        return False\n\n    # Check last character is digit or 'X'\n    if not (isbn[9].isdigit() or isbn[9] == 'X'):\n        return False\n\n    total = 0\n    for i in range(9):\n        total += (10 - i) * int(isbn[i])\n\n    # Check digit\n    if isbn[9] == 'X':\n        total += 10 * 1\n    else:\n        total += int(isbn[9]) * 1\n\n    return total % 11 == 0\n","expected_sha256":"114aa799811c51f89a8ba9fc5692b4e682023d46a66fa224e724a76b75c28e58","kind":"modify","path":"src/isbn.py"}],"rationale":"Fixed is_valid_isbn10 to correctly handle 'X' as a valid check digit with value 10 in the last position, preserving the public API and existing tests."}