import re


def parse_pairs(s):
    """Parse a string of key=value pairs separated by commas into a dict.

    Returns an empty dict for empty input.
    Ignores blank items.

    Example:
        'a=1,b=2' -> {'a': '1', 'b': '2'}
    """
    if not s or s.strip() == '':
        return {}

    pairs = s.split(',')
    result = {}
    for pair in pairs:
        pair = pair.strip()
        if not pair:
            continue
        if '=' not in pair:
            # If no '=', treat as key with empty string value
            key = pair
            value = ''
        else:
            key, value = pair.split('=', 1)
            key = key.strip()
            value = value.strip()
        result[key] = value
    return result
