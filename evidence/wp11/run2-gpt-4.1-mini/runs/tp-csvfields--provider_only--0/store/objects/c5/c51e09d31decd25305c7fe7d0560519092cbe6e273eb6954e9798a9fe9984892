def split_fields(line):
    """Split a CSV line into fields, handling quoted fields with commas and escaped quotes.

    Args:
        line (str): A single line of CSV text.

    Returns:
        list of str: The parsed fields.

    This function handles:
    - Fields enclosed in double quotes, which may contain commas.
    - Escaped double quotes inside quoted fields represented by doubled double quotes.
    """
    fields = []
    field = []
    in_quotes = False
    i = 0
    length = len(line)

    while i < length:
        c = line[i]

        if in_quotes:
            if c == '"':
                # Check if this is an escaped double quote
                if i + 1 < length and line[i + 1] == '"':
                    field.append('"')
                    i += 1  # Skip the next quote
                else:
                    in_quotes = False
            else:
                field.append(c)
        else:
            if c == '"':
                in_quotes = True
            elif c == ',':
                fields.append(''.join(field))
                field = []
            else:
                field.append(c)
        i += 1

    # Append the last field
    fields.append(''.join(field))

    return fields
