{"operations":[{"content":"def split_fields(line):\n    \"\"\"Split a CSV line into fields, handling quoted fields with commas and escaped quotes.\n\n    Args:\n        line (str): A single line of CSV text.\n\n    Returns:\n        list of str: The parsed fields.\n\n    This function handles:\n    - Fields enclosed in double quotes, which may contain commas.\n    - Escaped double quotes inside quoted fields represented by doubled double quotes.\n    \"\"\"\n    fields = []\n    field = []\n    in_quotes = False\n    i = 0\n    length = len(line)\n\n    while i < length:\n        c = line[i]\n\n        if in_quotes:\n            if c == '\"':\n                # Check if this is an escaped double quote\n                if i + 1 < length and line[i + 1] == '\"':\n                    field.append('\"')\n                    i += 1  # Skip the next quote\n                else:\n                    in_quotes = False\n            else:\n                field.append(c)\n        else:\n            if c == '\"':\n                in_quotes = True\n            elif c == ',':\n                fields.append(''.join(field))\n                field = []\n            else:\n                field.append(c)\n        i += 1\n\n    # Append the last field\n    fields.append(''.join(field))\n\n    return fields\n","expected_sha256":"1efa2ab596513250c35fb383e54d6413fb5f9b3e1dad574c3f0d8cda0daeb049","kind":"modify","path":"src/csvfields.py"}],"rationale":"Rewrote split_fields to correctly handle quoted fields containing commas and to unescape doubled double quotes inside quoted fields, preserving the public API and existing tests."}