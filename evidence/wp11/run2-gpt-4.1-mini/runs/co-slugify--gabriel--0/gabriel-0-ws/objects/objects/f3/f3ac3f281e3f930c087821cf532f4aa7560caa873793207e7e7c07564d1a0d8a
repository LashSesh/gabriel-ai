{"operations":[{"content":"import re\n\ndef slugify(text):\n    \"\"\"Convert text to a slug by collapsing runs of non-alphanumeric characters into a single hyphen,\n    and ensuring the result does not start or end with a hyphen, and is lowercase.\"\"\"\n    # Lowercase the input text\n    text = text.lower()\n    # Replace runs of non-alphanumeric characters with a single hyphen\n    slug = re.sub(r'[^a-z0-9]+', '-', text)\n    # Strip leading and trailing hyphens\n    slug = slug.strip('-')\n    return slug\n","expected_sha256":"d9b935daaa1d9715e2b1d01f610fc2ae54909070a54fe19b1230f8ae1a3ed1a4","kind":"modify","path":"src/slug.py"}],"rationale":"The original slugify did not lowercase the input, causing test failures. Adding text.lower() before substitution ensures the slug is lowercase, meeting the oracle's expectations while preserving the collapsing and trimming behavior."}