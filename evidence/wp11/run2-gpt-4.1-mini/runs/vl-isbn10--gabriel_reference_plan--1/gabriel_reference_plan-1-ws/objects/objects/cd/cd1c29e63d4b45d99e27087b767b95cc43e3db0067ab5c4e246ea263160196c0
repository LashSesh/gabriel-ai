{"operations":[{"content":"import re\n\n\ndef is_valid_isbn10(isbn):\n    \"\"\"Check if the given string is a valid ISBN-10.\n\n    The ISBN-10 consists of 9 digits plus a check digit which can be 0-9 or 'X' (representing 10).\n    Hyphens are allowed and ignored.\n\n    Args:\n        isbn (str): The ISBN-10 string to validate.\n\n    Returns:\n        bool: True if valid ISBN-10, False otherwise.\n    \"\"\"\n    # Remove hyphens\n    isbn = isbn.replace('-', '')\n\n    # ISBN-10 must be 10 characters\n    if len(isbn) != 10:\n        return False\n\n    # First 9 characters must be digits\n    if not isbn[:9].isdigit():\n        return False\n\n    # Last character can be digit or 'X'\n    if not (isbn[9].isdigit() or isbn[9] == 'X'):\n        return False\n\n    # Calculate checksum\n    total = 0\n    for i in range(9):\n        total += (i + 1) * int(isbn[i])\n\n    # Check digit\n    if isbn[9] == 'X':\n        total += 10 * 10\n    else:\n        total += 10 * int(isbn[9])\n\n    return total % 11 == 0\n\n\n# Other functions in isbn.py (if any) remain unchanged\n","expected_sha256":"114aa799811c51f89a8ba9fc5692b4e682023d46a66fa224e724a76b75c28e58","kind":"modify","path":"src/isbn.py"}],"rationale":"Fixed is_valid_isbn10 to correctly handle 'X' as a valid check digit representing 10 in the last position, preserving the public API and existing tests."}