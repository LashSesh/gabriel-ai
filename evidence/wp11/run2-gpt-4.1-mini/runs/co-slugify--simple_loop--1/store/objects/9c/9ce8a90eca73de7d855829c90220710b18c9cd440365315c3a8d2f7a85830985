{"operations":[{"content":"import re\n\n\ndef slugify(text):\n    \"\"\"Convert text to a slug by collapsing runs of non-alphanumeric characters into a single hyphen,\n    and ensuring the result does not start or end with a hyphen.\"\"\"\n    # Lowercase the input text\n    text = text.lower()\n    # Replace runs of non-alphanumeric characters with a single hyphen\n    slug = re.sub(r'[^a-z0-9]+', '-', text)\n    # Strip leading and trailing hyphens\n    slug = slug.strip('-')\n    return slug\n","expected_sha256":"ca48adec3235135c40dc72c9576d8f8113f1dd872955eb92242e45eb62bf6dd8","kind":"modify","path":"src/slug.py"}],"rationale":"Added lowercasing to meet test expectations and adjusted regex to lowercase letters only, ensuring runs of non-alphanumeric characters collapse to a single hyphen and no leading/trailing hyphens remain."}