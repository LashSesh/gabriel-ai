{"operations":[{"content":"def is_valid_email(email: str) -> bool:\n    \"\"\"Check if the email is valid.\n\n    The domain part must contain a dot with at least one character before and after it.\n    \"\"\"\n    if '@' not in email:\n        return False\n    local, domain = email.rsplit('@', 1)\n    if not local or not domain:\n        return False\n    # domain must contain a dot with at least one character before and after it\n    if '.' not in domain:\n        return False\n    dot_index = domain.find('.')\n    if dot_index == 0 or dot_index == len(domain) - 1:\n        return False\n    return True\n","expected_sha256":"96a692750dc93725bdc45320b6fae8958c5c8b03105242f4cac85ac4e3f3b4db","kind":"modify","path":"src/emailcheck.py"}],"rationale":"Updated is_valid_email to enforce that the domain part contains a dot with at least one character before and after it, as required by the defect report, while keeping the public API and existing tests unchanged."}