{"operations":[{"content":"def to_int(s: str) -> int:\n    \"\"\"Convert a Roman numeral to an integer, handling subtractive notation.\"\"\"\n    roman_map = {\n        'I': 1,\n        'V': 5,\n        'X': 10,\n        'L': 50,\n        'C': 100,\n        'D': 500,\n        'M': 1000\n    }\n    total = 0\n    prev_value = 0\n    for char in reversed(s):\n        value = roman_map[char]\n        if value < prev_value:\n            total -= value\n        else:\n            total += value\n        prev_value = value\n    return total\n","expected_sha256":"1eabf913364356c5c6463802383d7a2aa2cdc25fb29652a22ed4d57dc38d39d4","kind":"modify","path":"src/roman.py"}],"rationale":"Modified to_int to correctly handle subtractive notation by iterating from right to left and subtracting when a smaller numeral precedes a larger one, ensuring 'IV' and 'MCMXCIV' convert correctly."}