def is_valid(number: str) -> bool:
    """Check if the provided number string is valid per the Luhn algorithm.

    The Luhn algorithm doubles every second digit from the right (excluding the rightmost check digit).
    """
    # Remove spaces
    number = number.replace(' ', '')
    if not number.isdigit() or len(number) == 0:
        return False

    total = 0
    # Process digits from right to left
    # The rightmost digit is the check digit and is not doubled
    # Double every second digit from the right (indexing from 0)
    digits = list(map(int, number))
    # Iterate over digits in reverse order
    for i in range(len(digits) - 1, -1, -1):
        digit = digits[i]
        # Determine if this digit should be doubled
        # The check digit (rightmost) is at index len(digits)-1 and is never doubled
        # So double digits where (len(digits) - 1 - i) % 2 == 1
        if (len(digits) - 1 - i) % 2 == 1:
            digit *= 2
            if digit > 9:
                digit -= 9
        total += digit

    return total % 10 == 0
