{"operations":[{"content":"def is_valid_email(email: str) -> bool:\n    \"\"\"Check if the email is valid.\n\n    A valid email has exactly one '@' symbol, and the domain part must contain a dot with at least one character before and after it.\n\n    Args:\n        email (str): The email address to validate.\n\n    Returns:\n        bool: True if valid, False otherwise.\n    \"\"\"\n    if email.count('@') != 1:\n        return False\n    local, domain = email.rsplit('@', 1)\n    if not local or not domain:\n        return False\n    # domain must contain a dot with at least one character before and after it\n    if '.' not in domain:\n        return False\n    dot_index = domain.find('.')\n    if dot_index == 0 or dot_index == len(domain) - 1:\n        return False\n    return True\n","expected_sha256":"198c5b2bc96fadece4a15b7c7036f1602470931981eb22cde28316292192e295","kind":"modify","path":"src/emailcheck.py"}],"rationale":"Added a check to ensure exactly one '@' symbol is present, fixing the defect where multiple '@' symbols were accepted."}