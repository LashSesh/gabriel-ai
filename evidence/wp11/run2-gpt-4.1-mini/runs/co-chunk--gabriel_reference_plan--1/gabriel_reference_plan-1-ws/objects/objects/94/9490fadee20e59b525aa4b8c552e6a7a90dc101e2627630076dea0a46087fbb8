def chunk(data, size):
    """Yield successive chunks from data of given size.

    If the length of data is not a multiple of size, the final partial chunk is yielded.
    If size is larger than the length of data, a single chunk containing all data is yielded.

    Args:
        data (bytes or str or list): The input data to chunk.
        size (int): The chunk size.

    Yields:
        bytes or str or list: Chunks of the input data.
    """
    if size <= 0:
        raise ValueError("size must be positive")
    if not data:
        return
    for i in range(0, len(data), size):
        yield data[i:i + size]
