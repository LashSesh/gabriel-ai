def chunk(data, size):
    """Yield successive chunks from data of given size.

    If size is larger than the length of data, yield one chunk containing all data.
    The final chunk may be smaller than size if data length is not a multiple of size.

    Args:
        data (bytes or str or list): The input data to chunk.
        size (int): The chunk size.

    Yields:
        chunks of data of length size, except possibly the last one.
    """
    if size <= 0:
        raise ValueError("size must be positive")

    length = len(data)
    if length == 0:
        return

    for start in range(0, length, size):
        yield data[start:start + size]
