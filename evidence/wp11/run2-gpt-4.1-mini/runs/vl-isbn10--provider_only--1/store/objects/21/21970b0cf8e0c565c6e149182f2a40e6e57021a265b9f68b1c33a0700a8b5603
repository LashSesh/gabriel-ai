def is_valid_isbn10(isbn):
    """Check if the given string is a valid ISBN-10.

    The ISBN-10 consists of 9 digits plus a check digit which may be 0-9 or 'X' (representing 10).
    Hyphens are ignored.

    Args:
        isbn (str): The ISBN-10 string to validate.

    Returns:
        bool: True if valid, False otherwise.
    """
    # Remove hyphens
    isbn = isbn.replace('-', '')

    # ISBN-10 must be 10 characters
    if len(isbn) != 10:
        return False

    # Check first 9 characters are digits
    if not isbn[:9].isdigit():
        return False

    # Check last character is digit or 'X'
    if not (isbn[9].isdigit() or isbn[9] == 'X'):
        return False

    total = 0
    for i in range(9):
        total += (i + 1) * int(isbn[i])

    # Check digit
    if isbn[9] == 'X':
        total += 10 * 10
    else:
        total += 10 * int(isbn[9])

    return total % 11 == 0
