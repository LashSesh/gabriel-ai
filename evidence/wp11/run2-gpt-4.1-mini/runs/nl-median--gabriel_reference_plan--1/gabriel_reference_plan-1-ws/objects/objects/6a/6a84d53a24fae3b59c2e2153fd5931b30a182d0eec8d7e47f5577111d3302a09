def median(data):
    """Return the median of the data as a float.

    For an even number of values, the median is the arithmetic mean of the two middle values.
    """
    sorted_data = sorted(data)
    n = len(sorted_data)
    mid = n // 2
    if n % 2 == 1:
        return float(sorted_data[mid])
    else:
        return (float(sorted_data[mid - 1]) + float(sorted_data[mid])) / 2.0

def mean(data):
    """Return the arithmetic mean of the data as a float."""
    return sum(data) / len(data) if data else 0.0
