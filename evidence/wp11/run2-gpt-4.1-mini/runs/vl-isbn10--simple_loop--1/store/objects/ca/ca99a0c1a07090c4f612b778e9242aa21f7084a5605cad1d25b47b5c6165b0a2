def is_valid_isbn10(isbn):
    """Return True if the given string is a valid ISBN-10.

    The ISBN-10 consists of 9 digits plus a check digit which may be 0-9 or X (representing 10).
    Hyphens are allowed and ignored.

    Examples:
    '0-306-40615-2' -> True
    '0-8044-2957-X' -> True
    """
    # Remove hyphens
    isbn = isbn.replace('-', '')
    if len(isbn) != 10:
        return False

    total = 0
    for i in range(9):
        if not isbn[i].isdigit():
            return False
        total += (i + 1) * int(isbn[i])

    # Check last digit
    if isbn[9] == 'X':
        total += 10 * 10
    elif isbn[9].isdigit():
        total += 10 * int(isbn[9])
    else:
        return False

    return total % 11 == 0
