{"operations":[{"content":"def is_valid_isbn10(isbn):\n    \"\"\"Return True if the given string is a valid ISBN-10.\n\n    The ISBN-10 consists of 9 digits plus a check digit which may be 0-9 or X (representing 10).\n    Hyphens are allowed and ignored.\n\n    Examples:\n    '0-306-40615-2' -> True\n    '0-8044-2957-X' -> True\n    \"\"\"\n    # Remove hyphens\n    isbn = isbn.replace('-', '')\n    if len(isbn) != 10:\n        return False\n\n    total = 0\n    for i in range(9):\n        if not isbn[i].isdigit():\n            return False\n        total += (i + 1) * int(isbn[i])\n\n    # Check last digit\n    if isbn[9] == 'X':\n        total += 10 * 10\n    elif isbn[9].isdigit():\n        total += 10 * int(isbn[9])\n    else:\n        return False\n\n    return total % 11 == 0\n","expected_sha256":"114aa799811c51f89a8ba9fc5692b4e682023d46a66fa224e724a76b75c28e58","kind":"modify","path":"src/isbn.py"}],"rationale":"Fixed is_valid_isbn10 to correctly handle 'X' as a valid check digit representing 10 in the last position, preserving the public API and existing tests."}