{"operations":[{"content":"from urllib.parse import unquote_plus\n\n\ndef parse_qs(qs):\n    \"\"\"Parse a query string into a dictionary mapping keys to values.\n\n    A plus sign in a value decodes to a space.\n    A key without an equals sign maps to an empty string.\n    Percent-decoding is applied.\n\n    Args:\n        qs (str): The query string to parse.\n\n    Returns:\n        dict: A dictionary mapping keys to values.\n    \"\"\"\n    result = {}\n    if not qs:\n        return result\n\n    pairs = qs.split('&')\n    for pair in pairs:\n        if '=' in pair:\n            key, value = pair.split('=', 1)\n            key = unquote_plus(key)\n            value = unquote_plus(value)\n        else:\n            key = unquote_plus(pair)\n            value = ''\n        # If key already exists, convert to list or append\n        if key in result:\n            if isinstance(result[key], list):\n                result[key].append(value)\n            else:\n                result[key] = [result[key], value]\n        else:\n            result[key] = value\n    return result\n","expected_sha256":"7441ed4a4b4007eb4319ef00c32094505a29e3c9d81f08cfe4b16bd50c36cce2","kind":"modify","path":"src/querystring.py"}],"rationale":"Changed parse_qs to return a dict mapping keys to single values or lists if multiple values exist, matching the expected API. Kept unquote_plus for plus-to-space and percent-decoding. Handled keys without '=' mapping to empty string."}