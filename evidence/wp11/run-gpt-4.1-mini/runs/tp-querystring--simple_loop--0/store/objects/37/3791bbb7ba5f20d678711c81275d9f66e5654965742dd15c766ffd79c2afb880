{"operations":[{"content":"import urllib.parse\n\ndef parse_qs(qs):\n    \"\"\"Parse a query string into a dictionary mapping keys to values.\n\n    A plus sign in a value decodes to a space.\n    A key without an equals sign maps to an empty string.\n    Percent-decoding is preserved.\n\n    Args:\n        qs (str): The query string to parse.\n\n    Returns:\n        dict: A dictionary mapping keys to values.\n    \"\"\"\n    result = {}\n    if not qs:\n        return result\n\n    pairs = qs.split('&')\n    for pair in pairs:\n        if '=' in pair:\n            key, value = pair.split('=', 1)\n            # Replace plus with space before percent-decoding\n            key = urllib.parse.unquote(key.replace('+', ' '))\n            value = urllib.parse.unquote(value.replace('+', ' '))\n        else:\n            # Key without equals sign maps to empty string\n            key = urllib.parse.unquote(pair.replace('+', ' '))\n            value = ''\n        result[key] = value\n    return result\n","expected_sha256":"7bf94e6f427f525a03819f2f9a6a0451ab72f718155d300377a67770f687a5bc","kind":"modify","path":"src/querystring.py"}],"rationale":"Modified parse_qs to decode plus signs as spaces in keys and values, and to map keys without '=' to empty strings, preserving percent-decoding and the public API."}