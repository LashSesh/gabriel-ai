    "patch_bytes": 501,
    "patch": "diff --git a/src/seqtools.py b/src/seqtools.py\nindex 030da4b..7d4147a 100644\n--- a/src/seqtools.py\n+++ b/src/seqtools.py\n@@ -1,5 +1,9 @@\n-\"\"\"seqtools: sequence helpers.\"\"\"\n-\n-\n-def dedupe(items):\n-    return list(set(items))\n+def dedupe(seq):\n+    \"\"\"Remove duplicates from the sequence while preserving order of first occurrence.\"\"\"\n+    seen = set()\n+    result = []\n+    for item in seq:\n+        if item not in seen:\n+            seen.add(item)\n+            result.append(item)\n+    return result\n",
