import urllib.parse


def parse_qs(qs):
    """Parse a query string into a dictionary mapping keys to values.

    - A plus sign '+' in a value decodes to a space.
    - A key without an equals sign maps to an empty string.
    - Percent-decoding is preserved.

    Args:
        qs (str): The query string to parse.

    Returns:
        dict: A dictionary mapping keys to values.
    """
    result = {}
    if not qs:
        return result

    pairs = qs.split('&')
    for pair in pairs:
        if '=' in pair:
            key, value = pair.split('=', 1)
            # Replace '+' with space before percent-decoding
            value = value.replace('+', ' ')
            key = urllib.parse.unquote(key)
            value = urllib.parse.unquote(value)
        else:
            key = urllib.parse.unquote(pair)
            value = ''
        result[key] = value
    return result
