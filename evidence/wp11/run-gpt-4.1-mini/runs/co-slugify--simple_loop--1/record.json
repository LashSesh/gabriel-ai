    "patch": "diff --git a/src/slug.py b/src/slug.py\nindex 551f8a1..9e21032 100644\n--- a/src/slug.py\n+++ b/src/slug.py\n@@ -1,6 +1,12 @@\n-\"\"\"slug: URL slugs.\"\"\"\n import re\n \n-\n def slugify(text):\n-    return re.sub(r\"[^a-z0-9]\", \"-\", text.lower())\n+    \"\"\"Convert text to a slug by collapsing runs of non-alphanumeric characters into a single hyphen,\n+    converting to lowercase, and ensuring the result does not start or end with a hyphen.\"\"\"\n+    # Replace runs of non-alphanumeric characters with a single hyphen\n+    slug = re.sub(r'[^a-zA-Z0-9]+', '-', text)\n+    # Strip leading and trailing hyphens\n+    slug = slug.strip('-')\n+    # Convert to lowercase\n+    slug = slug.lower()\n+    return slug\n",
