{"operations":[{"content":"import re\n\ndef slugify(text):\n    \"\"\"Convert text to a slug by collapsing runs of non-alphanumeric characters into a single hyphen,\n    and ensuring the result does not start or end with a hyphen.\"\"\"\n    # Replace runs of non-alphanumeric characters with a single hyphen\n    slug = re.sub(r'[^a-zA-Z0-9]+', '-', text)\n    # Strip leading and trailing hyphens\n    slug = slug.strip('-')\n    return slug\n","expected_sha256":"1e9d120348c7179cb629b3583043390d8615862a5dc5d5004ec112a73581f950","kind":"modify","path":"src/slug.py"}],"rationale":"Updated slugify to collapse runs of non-alphanumeric characters into a single hyphen and strip leading/trailing hyphens, meeting the defect requirements while preserving the public API and existing tests."}