{"operations":[{"content":"import re\n\ndef slugify(text):\n    \"\"\"Convert text to a slug by collapsing runs of non-alphanumeric characters into a single hyphen,\n    converting to lowercase, and ensuring the result does not start or end with a hyphen.\"\"\"\n    # Replace runs of non-alphanumeric characters with a single hyphen\n    slug = re.sub(r'[^a-zA-Z0-9]+', '-', text)\n    # Strip leading and trailing hyphens\n    slug = slug.strip('-')\n    # Convert to lowercase\n    slug = slug.lower()\n    return slug\n","expected_sha256":"d9b935daaa1d9715e2b1d01f610fc2ae54909070a54fe19b1230f8ae1a3ed1a4","kind":"modify","path":"src/slug.py"}],"rationale":"Added conversion to lowercase to meet test expectations and user requirement, while preserving collapsing runs of non-alphanumeric characters and trimming hyphens."}