{"operations":[{"content":"def parse_pairs(s):\n    \"\"\"Parse a string of key=value pairs separated by commas into a dict.\n\n    Blank items are ignored. Empty input returns an empty dict.\n\n    Example:\n        'a=1,b=2' -> {'a': '1', 'b': '2'}\n        '' -> {}\n        'a=1,,b=2' -> {'a': '1', 'b': '2'}\n    \"\"\"\n    if not s:\n        return {}\n    pairs = s.split(',')\n    result = {}\n    for pair in pairs:\n        pair = pair.strip()\n        if not pair:\n            continue\n        if '=' not in pair:\n            # If no '=', skip or raise? Original behavior preserved (skip)\n            continue\n        key, value = pair.split('=', 1)\n        result[key.strip()] = value.strip()\n    return result\n","expected_sha256":"87750e77b314d49c0a647137c272d58bac34df90ca4c6e579e0582ca761721d3","kind":"modify","path":"src/kvparse.py"}],"rationale":"Modified parse_pairs to return empty dict on empty input and skip blank items, preserving public API and existing behavior otherwise."}