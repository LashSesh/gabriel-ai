{"operations":[{"content":"import re\n\ndef slugify(text):\n    \"\"\"Convert text to a slug by collapsing runs of non-alphanumeric characters into a single hyphen,\n    and ensuring the result does not start or end with a hyphen.\"\"\"\n    # Replace runs of non-alphanumeric characters with a single hyphen\n    slug = re.sub(r'[^a-zA-Z0-9]+', '-', text)\n    # Strip leading and trailing hyphens\n    slug = slug.strip('-')\n    # Collapse multiple hyphens into one (in case strip introduced any issues)\n    slug = re.sub(r'-{2,}', '-', slug)\n    return slug\n","expected_sha256":"d9b935daaa1d9715e2b1d01f610fc2ae54909070a54fe19b1230f8ae1a3ed1a4","kind":"modify","path":"src/slug.py"}],"rationale":"Added an extra step to collapse multiple hyphens into a single hyphen after stripping to ensure runs of non-alphanumeric characters collapse properly and no leading/trailing hyphens remain, fixing the defect as requested."}