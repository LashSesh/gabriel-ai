class Roman:
    _roman_numerals = {
        'I': 1,
        'V': 5,
        'X': 10,
        'L': 50,
        'C': 100,
        'D': 500,
        'M': 1000
    }

    @staticmethod
    def to_int(s: str) -> int:
        total = 0
        prev_value = 0
        for char in reversed(s):
            value = Roman._roman_numerals[char]
            if value < prev_value:
                total -= value
            else:
                total += value
            prev_value = value
        return total
