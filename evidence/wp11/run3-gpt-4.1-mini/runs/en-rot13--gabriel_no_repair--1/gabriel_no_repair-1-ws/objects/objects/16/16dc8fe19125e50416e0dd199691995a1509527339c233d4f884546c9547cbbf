"""rot13: letter rotation cipher."""


def rot13(text):
    """Rotate every ASCII letter by 13 places; other characters are unchanged."""
    out = []
    for ch in text:
        if 'a' <= ch <= 'z':
            out.append(chr((ord(ch) - ord('a') + 13) % 26 + ord('a')))
        elif 'A' <= ch <= 'Z':
            out.append(chr((ord(ch) - ord('A') + 13) % 26 + ord('A')))
        else:
            out.append(ch)
    return ''.join(out)
