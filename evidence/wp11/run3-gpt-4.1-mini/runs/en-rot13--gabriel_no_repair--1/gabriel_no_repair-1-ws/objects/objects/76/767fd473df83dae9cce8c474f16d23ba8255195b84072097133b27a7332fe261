{"operations":[{"content":"\"\"\"rot13: letter rotation cipher.\"\"\"\n\n\ndef rot13(text):\n    \"\"\"Rotate every ASCII letter by 13 places; other characters are unchanged.\"\"\"\n    out = []\n    for ch in text:\n        if 'a' <= ch <= 'z':\n            out.append(chr((ord(ch) - ord('a') + 13) % 26 + ord('a')))\n        elif 'A' <= ch <= 'Z':\n            out.append(chr((ord(ch) - ord('A') + 13) % 26 + ord('A')))\n        else:\n            out.append(ch)\n    return ''.join(out)\n","expected_sha256":"a87705ef3bd47ded35dcd45f3ac9caf5fb7080d6e1bb232081662cd3f087fff1","kind":"modify","path":"src/rot13.py"}],"rationale":"Added uppercase letter rotation to rot13 function to handle A-Z correctly while preserving case and leaving non-letters unchanged."}