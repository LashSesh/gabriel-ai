    "patch": "diff --git a/src/chunking.py b/src/chunking.py\nindex 37221a6..c73b1db 100644\n--- a/src/chunking.py\n+++ b/src/chunking.py\n@@ -4,4 +4,11 @@\n def chunk(items, size):\n     if size <= 0:\n         raise ValueError(\"size must be positive\")\n-    return [items[i:i + size] for i in range(0, len(items) - size + 1, size)]\n+    if len(items) == 0:\n+        return []\n+    # If size is larger than input, return one chunk\n+    if size >= len(items):\n+        return [items]\n+    # Otherwise, chunk normally, including final partial chunk\n+    chunks = [items[i:i + size] for i in range(0, len(items), size)]\n+    return chunks\n",
