{"operations":[{"content":"\"\"\"emailcheck: minimal e-mail address validation.\"\"\"\n\n\ndef is_valid_email(text):\n    if text.count(\"@\") != 1:\n        return False\n    local, domain = text.split(\"@\")\n    if not local or not domain or \" \" in text:\n        return False\n    # domain must contain a dot with at least one character before and after it\n    if \".\" not in domain:\n        return False\n    parts = domain.split(\".\")\n    # check that no part is empty (i.e. dot not at start or end, and no consecutive dots)\n    if any(not part for part in parts):\n        return False\n    return True\n","expected_sha256":"96a692750dc93725bdc45320b6fae8958c5c8b03105242f4cac85ac4e3f3b4db","kind":"modify","path":"src/emailcheck.py"}],"rationale":"Enhanced is_valid_email to enforce that the domain part contains at least one dot with characters before and after it, ensuring addresses like 'a@b' are invalid while 'a@b.co' are valid, as requested, without changing the public API or existing tests."}