{"operations":[{"content":"\"\"\"isbn: ISBN-10 validation.\"\"\"\n\n\ndef is_valid_isbn10(text):\n    digits = [ch for ch in text if ch != \"-\"]\n    if len(digits) != 10:\n        return False\n    # Check first 9 digits are digits\n    if not all(ch.isdigit() for ch in digits[:9]):\n        return False\n    # Check last digit is digit or 'X'\n    if not (digits[9].isdigit() or digits[9] == 'X'):\n        return False\n    total = 0\n    for index, ch in enumerate(digits):\n        if ch == 'X':\n            value = 10\n        else:\n            value = int(ch)\n        total += (10 - index) * value\n    return total % 11 == 0\n","expected_sha256":"114aa799811c51f89a8ba9fc5692b4e682023d46a66fa224e724a76b75c28e58","kind":"modify","path":"src/isbn.py"}],"rationale":"Allow the last character to be 'X' representing 10 as a valid ISBN-10 check digit, while keeping the rest of the validation logic intact and preserving the public API and existing tests."}