{"operations":[{"content":"\"\"\"csvfields: split one CSV line into fields (RFC 4180 subset).\"\"\"\n\ndef split_fields(line):\n    fields, current, quoted = [], [], False\n    i = 0\n    while i < len(line):\n        ch = line[i]\n        if quoted:\n            if ch == '\"':\n                # Check for escaped double quote\n                if i + 1 < len(line) and line[i + 1] == '\"':\n                    current.append('\"')\n                    i += 1  # skip the escaped quote\n                else:\n                    quoted = False\n            else:\n                current.append(ch)\n        elif ch == '\"':\n            quoted = True\n        elif ch == \",\":\n            fields.append(\"\".join(current))\n            current = []\n        else:\n            current.append(ch)\n        i += 1\n    fields.append(\"\".join(current))\n    return fields\n","expected_sha256":"1efa2ab596513250c35fb383e54d6413fb5f9b3e1dad574c3f0d8cda0daeb049","kind":"modify","path":"src/csvfields.py"}],"rationale":"Fixed split_fields to correctly handle doubled double-quotes inside quoted fields by unescaping them to a single double-quote, and allowed commas inside quoted fields by not splitting on commas when inside quotes, preserving the public API and existing tests."}