"""luhn: Luhn checksum validation for identification numbers."""


def is_valid(text):
    digits = [int(ch) for ch in text if ch.isdigit()]
    if len(digits) < 2:
        return False
    total = 0
    # Double every second digit from the right (excluding the check digit at the rightmost)
    for i in range(len(digits)):
        digit = digits[-(i + 1)]
        if i % 2 == 1:
            digit *= 2
            if digit > 9:
                digit -= 9
        total += digit
    return total % 10 == 0
