{"operations":[{"content":"\"\"\"isbn: ISBN-10 validation.\"\"\"\n\n\ndef is_valid_isbn10(text):\n    digits = [ch for ch in text if ch != \"-\"]\n    if len(digits) != 10:\n        return False\n    # Check all but last are digits\n    if not all(ch.isdigit() for ch in digits[:-1]):\n        return False\n    # Last digit can be digit or 'X'\n    if not (digits[-1].isdigit() or digits[-1] == 'X'):\n        return False\n\n    total = 0\n    for index, ch in enumerate(digits):\n        if ch == 'X':\n            value = 10\n        else:\n            value = int(ch)\n        total += (10 - index) * value\n    return total % 11 == 0\n","expected_sha256":"114aa799811c51f89a8ba9fc5692b4e682023d46a66fa224e724a76b75c28e58","kind":"modify","path":"src/isbn.py"}],"rationale":"Modified is_valid_isbn10 to allow 'X' as a valid check digit (value 10) in the last position, preserving the public API and existing tests."}