"""emailcheck: minimal e-mail address validation."""


def is_valid_email(text):
    if text.count("@") != 1:
        return False
    local, domain = text.split("@")
    if not local or not domain or " " in text:
        return False
    # domain must contain a dot with at least one character before and after it
    if "." not in domain:
        return False
    dot_index = domain.find(".")
    if dot_index == 0 or dot_index == len(domain) - 1:
        return False
    return True
