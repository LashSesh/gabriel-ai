{"operations":[{"content":"\"\"\"emailcheck: minimal e-mail address validation.\"\"\"\n\n\ndef is_valid_email(text):\n    if text.count(\"@\") != 1:\n        return False\n    local, domain = text.split(\"@\")\n    if not local or not domain or \" \" in text:\n        return False\n    # domain must contain a dot with at least one character before and after it\n    if \".\" not in domain:\n        return False\n    dot_index = domain.find(\".\")\n    if dot_index == 0 or dot_index == len(domain) - 1:\n        return False\n    return True\n","expected_sha256":"96a692750dc93725bdc45320b6fae8958c5c8b03105242f4cac85ac4e3f3b4db","kind":"modify","path":"src/emailcheck.py"}],"rationale":"Enhanced is_valid_email to check that the domain part contains a dot with at least one character before and after it, fulfilling the requirement that 'a@b' is invalid but 'a@b.co' is valid, while preserving the existing API and tests."}