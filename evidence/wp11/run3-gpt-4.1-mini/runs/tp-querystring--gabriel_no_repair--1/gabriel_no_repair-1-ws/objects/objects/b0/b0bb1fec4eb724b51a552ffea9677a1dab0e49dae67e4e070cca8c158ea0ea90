{"operations":[{"content":"\"\"\"querystring: parse application/x-www-form-urlencoded strings.\"\"\"\nfrom urllib.parse import unquote_plus\n\n\ndef parse_qs(text):\n    result = {}\n    if not text:\n        return result\n    for part in text.split(\"&\"):\n        if \"=\" not in part:\n            # key without '=' maps to empty string\n            key = unquote_plus(part)\n            result[key] = \"\"\n        else:\n            key, value = part.split(\"=\", 1)\n            result[unquote_plus(key)] = unquote_plus(value)\n    return result\n","expected_sha256":"7bf94e6f427f525a03819f2f9a6a0451ab72f718155d300377a67770f687a5bc","kind":"modify","path":"src/querystring.py"}],"rationale":"Changed unquote to unquote_plus to decode plus signs as spaces, and added handling for keys without '=' to map to empty string, preserving percent-decoding and the public API."}