{"operations":[{"content":"\"\"\"querystring: parse application/x-www-form-urlencoded strings.\"\"\"\nfrom urllib.parse import unquote\n\n\ndef parse_qs(text):\n    result = {}\n    if not text:\n        return result\n    for part in text.split(\"&\"):\n        if \"=\" not in part:\n            # key without '=' maps to empty string\n            key = unquote(part)\n            result[key] = \"\"\n            continue\n        key, value = part.split(\"=\", 1)\n        # plus signs decode to spaces\n        key = unquote(key.replace('+', ' '))\n        value = unquote(value.replace('+', ' '))\n        result[key] = value\n    return result\n","expected_sha256":"7bf94e6f427f525a03819f2f9a6a0451ab72f718155d300377a67770f687a5bc","kind":"modify","path":"src/querystring.py"}],"rationale":"Modified parse_qs to decode plus signs as spaces in keys and values, and to map keys without '=' to empty strings, preserving percent-decoding and the public API."}