{"operations":[{"content":"\"\"\"kvparse: parse comma-separated key=value pairs.\"\"\"\n\n\ndef parse_pairs(text):\n    \"\"\"Return a dict of key -> value for ``\"a=1,b=2\"``.\"\"\"\n    result = {}\n    if not text.strip():\n        return result\n    for item in text.split(\",\"):\n        item = item.strip()\n        if not item:\n            continue\n        key, _, value = item.partition(\"=\")\n        result[key.strip()] = value.strip()\n    return result\n","expected_sha256":"87750e77b314d49c0a647137c272d58bac34df90ca4c6e579e0582ca761721d3","kind":"modify","path":"src/kvparse.py"}],"rationale":"Modified parse_pairs to return empty dict for empty input and skip blank items, preserving API and existing behavior."}