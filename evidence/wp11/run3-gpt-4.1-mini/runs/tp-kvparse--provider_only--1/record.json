    "patch": "diff --git a/src/kvparse.py b/src/kvparse.py\nindex e5377f0..96ac50f 100644\n--- a/src/kvparse.py\n+++ b/src/kvparse.py\n@@ -4,7 +4,12 @@\n def parse_pairs(text):\n     \"\"\"Return a dict of key -> value for ``\"a=1,b=2\"``.\"\"\"\n     result = {}\n+    if not text.strip():\n+        return result\n     for item in text.split(\",\"):\n+        item = item.strip()\n+        if not item:\n+            continue\n         key, _, value = item.partition(\"=\")\n         result[key.strip()] = value.strip()\n     return result\n",
