{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "subject": {
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "type": "string"
    },
    "unit": {
      "enum": [
        "count"
      ],
      "type": "string"
    }
  },
  "required": [
    "subject",
    "unit"
  ],
  "title": "Synthetic fixture port input",
  "type": "object"
}
